@embed_string _sokol_ui_shader_src:
"""
struct CPU2Vertex
{
  float4 dst_rect_px     : POS;
  float4 src_rect_px     : TEX;
  float4 color           : COLOR;
  float4 corner_radii_px : CRAD;
  float4 style_params    : STY; // x: border_thickness_px, y: softness_px, z: omit_texture, w: unused
  uint vertex_id         : SV_VertexID;
};

struct Vertex2Pixel {
    float4 position                    : SV_POSITION;
	float2 texcoord_pct                : TEXCOORD0;
  	float4 tint         			   : COLOR0;
  	nointerpolation float omit_texture : TEXCOORD1;
	float2 rect_pos_px                 : TEXCOORD2; // @Added(borders) this pixel's position in the rect, from its top-left
	nointerpolation float2 rect_size_px        : TEXCOORD3; // @Added(borders)
	nointerpolation float border_thickness_px  : TEXCOORD4; // @Added(borders)
	float corner_radius_px                     : TEXCOORD5; // @Added(corners) this corner's at each vertex, so it is the nearest corner's by the time a pixel is near one
	nointerpolation float softness_px          : TEXCOORD6; // @Added(corners)
};

cbuffer Globals : register(b0) {
    int2 screen_resolution;
	float2 texture_t2d_size_px;
}

//- vertex shader

Vertex2Pixel vs_main(CPU2Vertex input) {
    Vertex2Pixel output;

    //Calculate screen position
	{
		static const float2 vertices[] = {
			float2(-1, -1),
			float2(-1, +1),
			float2(+1, -1),
			float2(+1, +1),
		};
		float2 top_left     = input.dst_rect_px.xy;
		float2 bottom_right = input.dst_rect_px.zw;
		float2 dst_half_size = (bottom_right - top_left) * 0.5;
		float2 dst_center = (bottom_right + top_left) * 0.5;
		float2 dst_pos = (vertices[input.vertex_id] * dst_half_size) + dst_center;
		output.position = float4(2 * dst_pos.x / screen_resolution.x - 1, 1 - (2 * dst_pos.y / screen_resolution.y), 0, 1);

		// Borders. Interpolated, so each pixel knows where it sits in the rect.
		output.rect_pos_px  = dst_pos - top_left;
		output.rect_size_px = bottom_right - top_left;
	}

	//src pixels -> uv pct
	{
		float2 src_p0 = input.src_rect_px.xy; // (x0,y0) top-left in pixels
		float2 src_p1 = input.src_rect_px.zw; // (x1,y1) bottom-right in pixels
		float2 src_verts_px[4] = {
			float2(src_p0.x, src_p0.y), // id 0: top-left
			float2(src_p0.x, src_p1.y), // id 1: bottom-left
			float2(src_p1.x, src_p0.y), // id 2: top-right
			float2(src_p1.x, src_p1.y), // id 3: bottom-right
		};

		output.texcoord_pct = (texture_t2d_size_px.x > 0 && texture_t2d_size_px.y > 0)
					? (src_verts_px[input.vertex_id] / texture_t2d_size_px)
					: float2(0,0);
	}

	//Color and style
    output.tint = input.color; // Pass color directly through
	output.omit_texture = input.style_params.z;
	output.border_thickness_px = input.style_params.x;
	output.softness_px = input.style_params.y;

	// Corners. corner_radii_px is R_Rect2DInst.corner_radii: Corner_00, 01, 10, 11
	// (top-left, bottom-left, top-right, bottom-right) - the order of the
	// vertices above.
	{
		float corner_radii[] = {
			input.corner_radii_px.x,
			input.corner_radii_px.y,
			input.corner_radii_px.z,
			input.corner_radii_px.w,
		};
		output.corner_radius_px = corner_radii[input.vertex_id];
	}

    return output;
}

//- pixel shader

Texture2D    main_t2d     : register(t0);
SamplerState main_sampler : register(s0);

// Distance from a rounded rect's edge: negative inside, positive outside.
// sample_pos is from the rect's centre. raddebugger's (render_d3d11.mdesk).
float rect_sdf(float2 sample_pos, float2 rect_half_size, float r) {
	return length(max(abs(sample_pos) - rect_half_size + r, 0.0)) - r;
}

float4 ps_main(Vertex2Pixel input) : SV_TARGET {
	// Rounded corners or a soft edge: the rect's shape comes from its distance
	// function, as in raddebugger's rect shader. The edge fades over
	// 2 * softness pixels, inside the rect. At least half a pixel, so a round
	// corner with no softness asked for is still smooth.
	float shape_alpha = 1;
	if(input.corner_radius_px > 0 || input.softness_px > 0) {
		float  softness_px    = max(input.softness_px, 0.5);
		float2 half_size_px   = input.rect_size_px * 0.5;
		float2 sdf_sample_pos = input.rect_pos_px - half_size_px;
		float2 soft_half_size = half_size_px - float2(softness_px * 2, softness_px * 2);

		float border_t = 1;
		if(input.border_thickness_px > 0) {
			float border_s = rect_sdf(sdf_sample_pos, soft_half_size - input.border_thickness_px, max(input.corner_radius_px - input.border_thickness_px, 0));
			border_t = smoothstep(0, 2 * softness_px, border_s);
		}
		if(border_t < 0.001) {
			discard;
		}

		float corner_s = rect_sdf(sdf_sample_pos, soft_half_size, input.corner_radius_px);
		float corner_t = 1 - smoothstep(0, 2 * softness_px, corner_s);

		shape_alpha = corner_t * border_t;
	}
	// Square and sharp, which is every rect that asks for neither - text too.
	// Borders - With a thickness set, only pixels within it of an edge are
	// drawn; the inside is left alone. Pixel centres sit on half pixels, so a
	// 1px border is exactly the outermost ring of pixels.
	else if(input.border_thickness_px > 0) {
		float2 to_far_edge = input.rect_size_px - input.rect_pos_px;
		float  edge_distance = min(min(input.rect_pos_px.x, input.rect_pos_px.y), min(to_far_edge.x, to_far_edge.y));
		if(edge_distance > input.border_thickness_px) {
			discard;
		}
	}

	float4 albedo = float4(1, 1, 1, 1);
	if(input.omit_texture < 1.0) {
		albedo = main_t2d.Sample(main_sampler, input.texcoord_pct);
	}

	float4 outcolor = albedo * input.tint;
	outcolor.a *= shape_alpha;
	return outcolor;
}
"""

@embed_string _sokol_test_shader_src:
"""
struct VS_Input {
	float2 top_left       : POS_TL; 
    float2 bottom_right   : POS_BR; 
    float2 uv_min         : TEX_MIN;   // Used for texturing
    float2 uv_max         : TEX_MAX;   // Used for texturing, zero indicates no texturing
    float4 color          : COLOR;     // Used for colored rectangles
    uint vertex_id        : SV_VertexID;
};

struct VS_Output {
    float4 position : SV_POSITION;
    float2 uv       : TEXCOORD; // Will be set regardless, but only used if texturing
    float4 color    : COLOR0;   // Always passed through, usage depends on texture check in PS
};

cbuffer Globals : register(b0) {
    int2 screen_resolution;
}

//- vertex shader

VS_Output vs_main(VS_Input input) {
    VS_Output output;

    static const float2 vertices[] = {
        float2(-1, -1),
        float2(-1, +1),
        float2(+1, -1),
        float2(+1, +1),
    };

    float2 dst_half_size = (input.bottom_right - input.top_left) * 0.5;
    float2 dst_center = (input.bottom_right + input.top_left) * 0.5;
    float2 dst_pos = (vertices[input.vertex_id] * dst_half_size) + dst_center;

    output.position = float4(2 * dst_pos.x / screen_resolution.x - 1, 1 - (2 * dst_pos.y / screen_resolution.y), 0, 1);

    // Set UVs regardless, but their usage depends on values in PS
    float2 uv = {0, 0};
    if(input.vertex_id == 0) uv = float2(input.uv_min.x, input.uv_max.y);
    else if(input.vertex_id == 1) uv = input.uv_min;
    else if(input.vertex_id == 2) uv = float2(input.uv_max.x, input.uv_max.y);
    else if(input.vertex_id == 3) uv = float2(input.uv_max.x, input.uv_min.y);
    output.uv = uv;

    output.color = input.color; // Pass color directly through
    return output;
}

//- pixel shader

Texture2D my_texture : register(t0);
SamplerState my_sampler : register(s0);

float4 ps_main(VS_Output input) : SV_TARGET {
    return my_texture.Sample(my_sampler, input.uv);
}
"""

@embed_string _sokol_finalized_shader_src:
"""
struct VSOut {
    float4 pos : SV_POSITION;
    float2 uv  : TEXCOORD0;
};

VSOut vs_main(uint vid : SV_VertexID) {
    VSOut o;
    // Triangle strip order: 0=BL, 1=TL, 2=BR, 3=TR
    float2 pos[4] = {
        float2(-1.0, -1.0),
        float2(-1.0,  1.0),
        float2( 1.0, -1.0),
        float2( 1.0,  1.0)
    };
    float2 uv[4] = {
        float2(0.0, 1.0),
        float2(0.0, 0.0),
        float2(1.0, 1.0),
        float2(1.0, 0.0)
    };
    o.pos = float4(pos[vid], 0.0, 1.0);
    o.uv  = uv[vid];
    return o;
}

Texture2D    stage_t2d : register(t0);
SamplerState stage_smp : register(s0);

float4 ps_main(VSOut i) : SV_TARGET {
    return stage_t2d.Sample(stage_smp, i.uv);
}
"""
